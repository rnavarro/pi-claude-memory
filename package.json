{
  "name": "pi-claude-memory",
  "version": "0.1.0",
  "description": "Pi extension: shared Claude Code memory store with project-scoped resolution and background auto-learning.",
  "type": "module",
  "license": "MIT",
  "author": "rnavarro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnavarro/pi-claude-memory.git"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "memory",
    "claude-code",
    "auto-learning"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings",
    "format": "biome check --write",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  }
}
